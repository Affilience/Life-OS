# ===========================================
# REQUIRED - Supabase Configuration
# Get these from: supabase.com → Project → Settings → API
# ===========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# OPTIONAL - Local Development
# ===========================================
VITE_API_URL=http://localhost:3001
VITE_DEV_MODE=false
VITE_USE_DEV_AUTH=false

# ===========================================
# OPTIONAL - Third-party APIs
# ===========================================
# RapidAPI key for nutrition data (Edamam)
VITE_RAPIDAPI_KEY=your-rapidapi-key

# FatSecret API (for food/nutrition search)
# Get from: https://platform.fatsecret.com/api/
VITE_FATSECRET_CLIENT_ID=your-fatsecret-client-id
VITE_FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# ===========================================
# SUPABASE SECRETS (Server-side)
# These are NOT frontend env vars!
# Set via: supabase secrets set KEY=value
# ===========================================
# ANTHROPIC_API_KEY=sk-ant-xxx     (for Nova AI chat)
# OPENAI_API_KEY=sk-xxx            (for embeddings)
#
# To set these secrets:
#   supabase link --project-ref your-project-ref
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-xxx
#   supabase secrets set OPENAI_API_KEY=sk-xxx
